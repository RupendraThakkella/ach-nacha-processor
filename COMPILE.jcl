//ACHCOMP  JOB 1,NOTIFY=&SYSUID
//*================================================================
//* ACHCOMP - COMPILE AND LINK THE THREE COBOL PROGRAMS
//*   USES THE IBM-SUPPLIED IGYWCL PROCEDURE (COMPILE + LINK)
//*   COPYBOOKS ARE READ FROM &SYSUID..ACH.COPYLIB
//*================================================================
//ACCTLOAD EXEC IGYWCL
//COBOL.SYSIN  DD DSN=&SYSUID..ACH.COBOL(ACCTLOAD),DISP=SHR
//COBOL.SYSLIB DD DSN=&SYSUID..ACH.COPYLIB,DISP=SHR
//LKED.SYSLMOD DD DSN=&SYSUID..LOAD(ACCTLOAD),DISP=SHR
//*
//ACHVALID EXEC IGYWCL
//COBOL.SYSIN  DD DSN=&SYSUID..ACH.COBOL(ACHVALID),DISP=SHR
//COBOL.SYSLIB DD DSN=&SYSUID..ACH.COPYLIB,DISP=SHR
//LKED.SYSLMOD DD DSN=&SYSUID..LOAD(ACHVALID),DISP=SHR
//*
//ACHPOST  EXEC IGYWCL
//COBOL.SYSIN  DD DSN=&SYSUID..ACH.COBOL(ACHPOST),DISP=SHR
//COBOL.SYSLIB DD DSN=&SYSUID..ACH.COPYLIB,DISP=SHR
//LKED.SYSLMOD DD DSN=&SYSUID..LOAD(ACHPOST),DISP=SHR
