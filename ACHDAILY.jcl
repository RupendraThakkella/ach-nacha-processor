//ACHDAILY JOB 1,NOTIFY=&SYSUID
//*================================================================
//* ACHDAILY - DAILY ACH INBOUND PROCESSING
//*
//*  CLEANUP  IEFBR14   DELETE YESTERDAY'S WORK FILES
//*  VALIDATE ACHVALID  VALIDATE THE NACHA FILE
//*                      RC 0/4 = CONTINUE,  RC 12 = FILE REJECTED
//*  SORTACH  DFSORT    SORT VALID ENTRIES BY ACCOUNT, TRACE NUMBER
//*  POST     ACHPOST   POST TO ACCOUNT MASTER, WRITE RETURNS
//*  PRINT    IDCAMS    PRINT THE UPDATED ACCOUNT MASTER
//*
//*  TO TEST THE REJECT PATH, CHANGE ACH.ACHIN TO ACH.ACHBAD IN
//*  THE VALIDATE STEP: VALIDATE ENDS RC 12 AND POSTING IS SKIPPED.
//*================================================================
//CLEANUP  EXEC PGM=IEFBR14
//DEL1     DD DSN=&SYSUID..ACH.VALID,
//            DISP=(MOD,DELETE,DELETE),SPACE=(TRK,(1,1))
//DEL2     DD DSN=&SYSUID..ACH.VALID.SORTED,
//            DISP=(MOD,DELETE,DELETE),SPACE=(TRK,(1,1))
//DEL3     DD DSN=&SYSUID..ACH.REJECTS,
//            DISP=(MOD,DELETE,DELETE),SPACE=(TRK,(1,1))
//DEL4     DD DSN=&SYSUID..ACH.RETURNS,
//            DISP=(MOD,DELETE,DELETE),SPACE=(TRK,(1,1))
//*
//*--- STEP 1: VALIDATE THE INCOMING NACHA FILE -------------------
//VALIDATE EXEC PGM=ACHVALID
//STEPLIB  DD DSN=&SYSUID..LOAD,DISP=SHR
//ACHIN    DD DSN=&SYSUID..ACH.ACHIN,DISP=SHR
//VALIDOUT DD DSN=&SYSUID..ACH.VALID,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5)),RECFM=FB,LRECL=100
//REJECTS  DD DSN=&SYSUID..ACH.REJECTS,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5)),RECFM=FB,LRECL=130
//VALRPT   DD SYSOUT=*,RECFM=FB,LRECL=133
//SYSOUT   DD SYSOUT=*
//*
//*--- ONLY CONTINUE IF THE FILE PASSED FILE-LEVEL VALIDATION -----
//IFVALID  IF (VALIDATE.RC < 8) THEN
//*
//*--- STEP 2: SORT VALID ENTRIES BY ACCOUNT (1,17), TRACE (39,15) -
//SORTACH  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..ACH.VALID,DISP=SHR
//SORTOUT  DD DSN=&SYSUID..ACH.VALID.SORTED,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5)),RECFM=FB,LRECL=100
//SYSIN    DD *
  SORT FIELDS=(1,17,CH,A,39,15,CH,A)
/*
//*
//IFSORTOK IF (SORTACH.RC = 0) THEN
//*
//*--- STEP 3: POST TO THE ACCOUNT MASTER --------------------------
//POST     EXEC PGM=ACHPOST
//STEPLIB  DD DSN=&SYSUID..LOAD,DISP=SHR
//VALIDIN  DD DSN=&SYSUID..ACH.VALID.SORTED,DISP=SHR
//ACCTMAST DD DSN=&SYSUID..ACH.ACCTMAST,DISP=OLD
//RETURNS  DD DSN=&SYSUID..ACH.RETURNS,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5)),RECFM=FB,LRECL=100
//POSTRPT  DD SYSOUT=*,RECFM=FB,LRECL=133
//SYSOUT   DD SYSOUT=*
//*
//*--- STEP 4: PRINT THE UPDATED ACCOUNT MASTER --------------------
//PRINT    EXEC PGM=IDCAMS,COND=(8,LT,POST)
//SYSPRINT DD SYSOUT=*
//ACCT     DD DSN=&SYSUID..ACH.ACCTMAST,DISP=SHR
//SYSIN    DD *
  PRINT INFILE(ACCT) DUMP
/*
//         ENDIF
//         ENDIF
