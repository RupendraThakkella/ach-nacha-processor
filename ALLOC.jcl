//ACHALLOC JOB 1,NOTIFY=&SYSUID
//*================================================================
//* ACHALLOC - ONE-TIME ALLOCATION OF PROJECT DATA SETS
//*   SOURCE LIBRARIES (PDS, FB 80) AND INPUT DATA SETS
//*   YOUR LOAD LIBRARY (&SYSUID..LOAD) IS ASSUMED TO EXIST
//*================================================================
//ALLOC    EXEC PGM=IEFBR14
//COBOL    DD DSN=&SYSUID..ACH.COBOL,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(10,5,10)),RECFM=FB,LRECL=80,DSORG=PO
//COPYLIB  DD DSN=&SYSUID..ACH.COPYLIB,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5,10)),RECFM=FB,LRECL=80,DSORG=PO
//JCL      DD DSN=&SYSUID..ACH.JCL,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5,10)),RECFM=FB,LRECL=80,DSORG=PO
//ACHIN    DD DSN=&SYSUID..ACH.ACHIN,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=94,DSORG=PS
//ACHBAD   DD DSN=&SYSUID..ACH.ACHBAD,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=94,DSORG=PS
//ACCTIN   DD DSN=&SYSUID..ACH.ACCTIN,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(1,1)),RECFM=FB,LRECL=80,DSORG=PS
